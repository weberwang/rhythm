          "type": "frame",
          "id": "UtwCg",
          "name": "Module Freeze Summary Row",
          "width": "fill_container",
          "gap": 20,
          "children": [
            {
              "type": "frame",
              "id": "gxkd5",
              "name": "Freeze Column A",
              "width": "fill_container",
              "fill": "$surface",
              "cornerRadius": 24,
              "stroke": "$border-subtle",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 12,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "n9dLN6",
                  "name": "Column Title",
                  "fill": "$text-primary",
                  "content": "Activation / Schedule / Sleep",
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "XAKRF",
                  "name": "Activation Block",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "activation-entry\nReusable: activation value card, permission benefit row, CTA composition.\nLocal: welcome hero, ready-transition cadence.\nStates: welcome, login, permission allow/manual, ready-complete.\nAllowed: provider availability, copy length, icon swap.",
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "X5SQro",
                  "name": "Schedule Block",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "schedule-reminders\nReusable: form row, strategy option, info card.\nLocal: target-time dual-card, timezone note wording.\nStates: selected/unselected strategy, saved baseline.\nAllowed: picker type, time format, timezone copy.",
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "DlzHr",
                  "name": "Sleep Block",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "sleep-records\nReusable: sleep result card, source card posture, chip group pattern.\nLocal: correction confirmation, source audit detail.\nStates: trusted result, partial data, correction available.\nAllowed: source label text, chip vocabulary, CTA wording.",
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "k3K7TR",
              "name": "Freeze Column B",
              "width": "fill_container",
              "fill": "$surface",
              "cornerRadius": 24,
              "stroke": "$border-subtle",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 12,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "Edt5K",
                  "name": "Column Title",
                  "fill": "$text-primary",
                  "content": "Bedtime / Today / Calendar",
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "GN7D3",
                  "name": "Bedtime Block",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "bedtime-session\nReusable: bedtime action card, tab bar, primary CTA composition.\nLocal: countdown hero, state triage, nightly action copy.\nStates: on-track, a-little-off, off-track, action-ready.\nAllowed: countdown format, action icon, nightly wording.",
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "P0sdY0",
                  "name": "Today Block",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "today-feedback\nReusable: today summary card, quick action posture, result derivative.\nLocal: greeting stack and daily narrative assembly.\nStates: summary-ready, action-ready, recovery-support.\nAllowed: greeting copy, quick action labels, metric values.",
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Yg0sr",
                  "name": "Calendar Block",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "calendar-history\nReusable: tab shell, selected-day emphasis, detail card posture.\nLocal: month grid arrangement, single-day sequence.\nStates: default day, selected day, delayed-night day, detail-open.\nAllowed: heatmap intensity, month label, filter text.",
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Kv1tJ",
              "name": "Freeze Column C",
              "width": "fill_container",
              "fill": "$surface",
              "cornerRadius": 24,
              "stroke": "$border-subtle",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 12,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "Zzh7I",
                  "name": "Column Title",
                  "fill": "$text-primary",
                  "content": "Insights / Account / Widget",
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "VCsbx",
                  "name": "Insights Block",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "insights-recovery\nReusable: insights metric card, report card posture, support card posture.\nLocal: chart stack sequencing, recovery narrative pacing.\nStates: metric default, report-highlighted, recovery-plan-ready.\nAllowed: metric labels, chart density, recommendation copy.",
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Fan06",
                  "name": "Account Block",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "account-sync-membership\nReusable: account sync summary card, membership value card, settings row pattern.\nLocal: deletion-risk explanation, purchase recovery copy.\nStates: anonymous-local-safe, sync-disconnected, membership-secondary-emphasis.\nAllowed: provider wording, restore text, privacy route labels.",
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "dtKcj",
                  "name": "Widget Block",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "widget-bridge\nReusable: widget mini card, primary CTA composition, support card posture.\nLocal: platform install steps, entry-source explanation.\nStates: widget-preview-ready, unsupported fallback, add-widget guidance.\nAllowed: install steps, platform labels, route wording.",
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    }
